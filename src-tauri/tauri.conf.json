{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Sorting Hat",
  "version": "0.1.0",
  "identifier": "app.photosortinghat.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "app": {
    "windows": [{ "title": "Photo Sorting Hat", "width": 1260, "height": 860, "minWidth": 900, "minHeight": 660 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "resources": ["resources/metadata/**/*"], "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }, "shortDescription": "An offline home for your photo archive", "category": "Photography", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
